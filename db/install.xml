<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="enrol/nephilazip/db" VERSION="2025012500" COMMENT="Nephila ZIP Payment Enrolment Plugin">
    <TABLES>

        <!-- =======================================================================
             Table: enrol_nephilazip_transactions
             Stores all transactions created through ZIP gateway.
        ======================================================================= -->
        <TABLE NAME="enrol_nephilazip_txns" COMMENT="ZIP payment transactions">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary Key"/>
                
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="User who is attempting to enrol"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course being purchased"/>
                <FIELD NAME="instanceid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Enrol instance ID"/>

                <FIELD NAME="zip_reference" TYPE="char" LENGTH="100" NOTNULL="false" COMMENT="ZIP transaction reference number"/>
                <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="false" COMMENT="pending|approved|declined|failed"/>

               <FIELD NAME="amount" TYPE="decimal" LENGTH="10,2" NOTNULL="false" COMMENT="Paid amount"/>
               <FIELD NAME="currency" TYPE="char" LENGTH="10" NOTNULL="false" DEFAULT="PHP" COMMENT="Currency"/>

                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="When transaction started"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Last update time"/>
            </FIELDS>

            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="courseid_fk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
                <KEY NAME="userid_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
                <KEY NAME="instanceid_fk" TYPE="foreign" FIELDS="instanceid" REFTABLE="enrol" REFFIELDS="id"/>
            </KEYS>
        </TABLE>

        <!-- =======================================================================
             Table: enrol_nephilazip_logs
             Store webhook updates for auditing.
        ======================================================================= -->
        <TABLE NAME="enrol_nephilazip_logs" COMMENT="Webhook logs">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>

                <FIELD NAME="reference" TYPE="char" LENGTH="100" NOTNULL="false" COMMENT="ZIP reference from webhook"/>
                <FIELD NAME="payload" TYPE="text" NOTNULL="false" COMMENT="Raw JSON from ZIP"/>
                <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="false" COMMENT="Webhook-reported status"/>

                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
            </FIELDS>

            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>

    </TABLES>
</XMLDB>
